{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "EDLS: Run app",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "EDLS: Self-test (headless)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/selftest.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "env": {
                "QT_QPA_PLATFORM": "offscreen"
            }
        },
        {
            "name": "EDLS: Current file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        }
    ]
}
